@page "/counter"
@rendermode InteractiveAuto

<div style="max-width: 500px; margin: 40px auto; font-family: 'Segoe UI', sans-serif;">
    
    <div style="background: #2c3e50; color: white; padding: 20px; border-radius: 10px 10px 0 0; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <h2 style="margin: 0; font-size: 1.5rem;">ToDo</h2>
        <p style="margin: 5px 0 0; opacity: 0.8; font-size: 0.9rem;">Всього завдань: @tasks.Count</p>
    </div>

    <div style="background: white; padding: 20px; border: 1px solid #ddd; border-top: none; border-radius: 0 0 10px 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        
        <div style="display: flex; gap: 10px; margin-bottom: 20px;">
            <input @bind="newTask" @onkeyup="HandleKeyUp"
                   placeholder="Завдання..." 
                   style="flex-grow: 1; padding: 12px; border: 1px solid #ccc; border-radius: 5px; outline: none;" />
            <button @onclick="AddTask" 
                    style="padding: 10px 20px; background: #27ae60; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
                Додати
            </button>
        </div>

        <ul style="list-style: none; padding: 0; margin: 0;">
            @foreach (var task in tasks)
            {
                <li style="display: flex; justify-content: space-between; padding: 12px; border-bottom: 1px solid #eee; align-items: center; transition: background 0.2s;">
                    <span style="color: #34495e;">@task</span>
                    <button @onclick="() => tasks.Remove(task)" 
                            style="background: none; border: none; color: #e74c3c; cursor: pointer; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">
                        Видалити
                    </button>
                </li>
            }
        </ul>

        @if (tasks.Count == 0)
        {
            <div style="text-align: center; padding: 30px; color: #bdc3c7;">
                <p style="margin: 0; font-style: italic;">Список порожній. Час відпочити! ☕</p>
            </div>
        }
    </div>
</div>

@code 
{
    private string? newTask;
    
    private List<string> tasks = new() 
    { 
        "виконати ЛР 1", 
        "підготовитись до заліку", 
        "розібратись з налаштуваннями Arduino" 
    };

    private void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTask))
        {
            tasks.Add(newTask);
            newTask = string.Empty;
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }
}